# Compiled binaries -- regenerate with rebuild.sh
g510_lcd_stats
g510_lcd_buttons
__pycache__/
*.pyc

# FONT.otf (primary label font) and FALLBACK.ttf (Liberation Sans
# Bold, SIL OFL, used if the primary ever fails to load) are both
# tracked and committed on purpose. Only the machine-generated .fnt
# files stay ignored -- build artifacts regenerated by
# install.sh/scripts/rebuild.sh, not something to commit.
fonts/*.fnt

# Generated at runtime, not part of the project itself
custom_screen_images/*.bin

# G510s runtime state -- your own live LCD layout and recorded macros,
# not part of the project itself. g510s-dev has already moved this to
# ~/.local/share/g510-lcd; this branch hasn't picked that code change
# up yet, but there's no reason to keep tracking the data itself in
# the meantime.
custom_screens.txt
macros.json

# Claude Code's own worktree bookkeeping -- not project content
.claude/
